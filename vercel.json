{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 128
    }
  },
  "rewrites": [
    { "source": "/route/:path*", "destination": "/api/:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
